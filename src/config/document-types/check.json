{
    "type": "CHECK",
    "placeholder": true,
    "_note": "Convention DERIVED from real filenames in Intake_Checks/{YYYY}/{YYYY_MM}/, not yet confirmed by the business. checkNumber and payee extract cleanly from the OCR text; checkDate is the weak field (OCR renders slashes as digits, e.g. 1/5/2026 -> '11512026'). Keep placeholder true until a dry run measures the real hit rate.",
    "enabled": true,
    "extensions": [
        ".pdf"
    ],
    "classify": {
        "filenameHints": [
            "check",
            "chk"
        ],
        "contentPatterns": [
            "\\bCheck\\s*Total\\b",
            "\\bCheck:\\s*\\d{6,}",
            "\\bNet\\s+Amount\\b"
        ],
        "minMatches": 1
    },
    "fields": {
        "checkNumber": {
            "pattern": "Check:\\s*0*(\\d{3,10})",
            "required": true,
            "transform": [
                "trim"
            ]
        },
        "payee": {
            "pattern": "([A-Z][A-Za-z0-9 &.,'#\\-]{2,60}?)\\s+Check\\s+Total",
            "required": true,
            "transform": [
                "trim",
                "upper"
            ],
            "maxLength": 60
        },
        "checkDate": {
            "pattern": "(\\d{1,2}[/\\-]\\d{1,2}[/\\-]\\d{4})\\s+[A-Z][^\\n]*?Check\\s+Total",
            "required": true,
            "transform": [
                "date:M_D_YYYY"
            ]
        }
    },
    "template": "Check_{checkNumber}_{payee}_{checkDate}",
    "validate": "^Check_\\d{3,10}_[A-Z0-9][A-Za-z0-9 &.,'#\\-]*_\\d{1,2}_\\d{1,2}_\\d{4}\\.pdf$"
}
