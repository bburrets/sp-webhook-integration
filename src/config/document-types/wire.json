{
    "type": "WIRE",
    "placeholder": true,
    "_note": "Convention DERIVED from real filenames in Intake_Wires/{YYYY_MM}/. Note the DOUBLE underscore after 'Wire' and that the amount keeps its dollar sign, thousands commas and cents. Many live files are malformed (e.g. 'Wire__$1,375,110.00_.pdf', 'Wire__$963,164.00_32_12_2026.pdf' where 32 is not a month) which is exactly what this sweep is meant to fix.",
    "enabled": true,
    "extensions": [".pdf"],
    "classify": {
        "filenameHints": ["wire"],
        "contentPatterns": [
            "\\bWire\\s+(?:Transfer|Payment|Advice)\\b",
            "\\bBeneficiary\\b",
            "\\bFed\\s*Reference\\b"
        ],
        "minMatches": 1
    },
    "fields": {
        "amount": {
            "pattern": "(?:Amount|Total|USD)[:\\s]*\\$?\\s*([\\d,]+\\.\\d{2})",
            "required": true,
            "transform": ["trim"]
        },
        "valueDate": {
            "pattern": "\\b(\\d{1,2}[/\\-]\\d{1,2}[/\\-]\\d{4})\\b",
            "required": true,
            "transform": ["date:MM_DD_YYYY"]
        }
    },
    "template": "Wire__${amount}_{valueDate}",
    "validate": "^Wire__\\$[\\d,]+\\.\\d{2}_\\d{2}_\\d{2}_\\d{4}\\.pdf$"
}
